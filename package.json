{
  "name": "shittim-chest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Standalone serverless client for the Blue Archive gacha calendar. Static build for GitHub Pages; forecast data is refreshed by a weekly cron workflow.",
  "scripts": {
    "export": "bun run scripts/export.ts",
    "dev": "vite",
    "build": "vite build",
    "editor:typecheck": "tsc --noEmit -p tools/spine-editor/tsconfig.json",
    "editor:desktop": "bun --cwd=tools/spine-editor/desktop run dev",
    "editor:desktop:build": "bun --cwd=tools/spine-editor/desktop run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "4.2.120",
    "@esotericsoftware/spine-webgl": "4.2.120",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "bun-types": "^1.4.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
